{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HttpsWrenchValues",
  "description": "Values schema for https-wrench Helm chart with upstream https-wrench configuration validation",
  "type": "object",
  "required": [
    "replicaCount",
    "image",
    "service",
    "serviceMonitor"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Number of deployment replicas"
    },
    "image": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "description": "Container image repository"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ],
          "default": "IfNotPresent"
        },
        "tag": {
          "type": "string",
          "description": "Image tag override (defaults to chart appVersion)"
        }
      }
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "service": {
      "type": "object",
      "required": [
        "type",
        "port"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "default": 9090
        },
        "name": {
          "type": "string",
          "default": "metrics"
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string"
        },
        "scrapeTimeout": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "default": "/metrics"
        },
        "labels": {
          "type": "object"
        },
        "metricRelabelings": {
          "type": "array"
        },
        "relabelings": {
          "type": "array"
        }
      }
    },
    "prometheusRule": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "labels": {
          "type": "object"
        },
        "annotations": {
          "type": "object"
        },
        "groupName": {
          "type": "string"
        },
        "rules": {
          "type": "object",
          "properties": {
            "probeFailed": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "for": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                }
              }
            },
            "certExpiringWarning": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "days": {
                  "type": "integer"
                },
                "for": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                }
              }
            },
            "certExpiringCritical": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "days": {
                  "type": "integer"
                },
                "for": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                }
              }
            },
            "certInvalid": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "for": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                }
              }
            },
            "pushErrors": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "for": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                }
              }
            }
          }
        },
        "additionalRules": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiVersion": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "gatewayClassName": {
          "type": "string"
        },
        "listeners": {
          "type": "array"
        }
      }
    },
    "virtualService": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiVersion": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gateways": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "http": {
          "type": "array"
        }
      }
    },
    "reload": {
      "type": "object",
      "properties": {
        "triggerChecksumAnnotation": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "existingConfigMap": {
      "type": "string"
    },
    "config": {
      "description": "Native https-wrench configuration validated directly against upstream JSON schema. Suggestion: add metrics.customLabels.job if missing so pushed metrics match standard Prometheus {job=\"...\"} queries.",
      "allOf": [
        {
          "$ref": "https://raw.githubusercontent.com/xenOs76/https-wrench/refs/heads/main/https-wrench.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "observability": {
              "type": "object",
              "properties": {
                "metrics": {
                  "type": "object",
                  "description": "Metrics filtering and label configuration. Suggestion: add metrics.customLabels.job if missing so pushed time series carry standard Prometheus job labels.",
                  "properties": {
                    "customLabels": {
                      "type": "object",
                      "description": "Key-value map of custom labels attached to all exported metrics. Suggestion: add 'job' if missing (e.g. 'requests-os76-https-wrench') so remote-written or OTLP-pushed metrics match Prometheus alert rules and Grafana queries.",
                      "properties": {
                        "job": {
                          "type": "string",
                          "description": "Prometheus job label. Suggested if missing when using push exporters (push.prometheus or push.otlp) to prevent empty query results when filtering by job."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}